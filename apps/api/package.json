{
  "name": "@morphic/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "seed:dahl": "tsx --env-file-if-exists=../../.env scripts/seed-dahl.ts",
    "build": "tsc --noEmit && tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --env-file-if-exists=../../.env src/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.15.0",
    "@morphic/db": "workspace:*",
    "@morphic/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.9.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  }
}
